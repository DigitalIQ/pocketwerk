    "A Dock icon can show one group or several. With several, swipe or use the arrow keys in the popup to switch." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Dock-Symbol kann eine oder mehrere Gruppen zeigen. Bei mehreren wechselst du im Popup per Wischen oder mit den Pfeiltasten."
          }
        }
      }
    },
    "A Space" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Space"
          }
        }
      }
    },
